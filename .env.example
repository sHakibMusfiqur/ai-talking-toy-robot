# Copy to .env (never commit .env) and replace values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Host-side development/test connection (single-node replica set, direct connection).
MONGO_HOST=mongodb://localhost:27017/?directConnection=true
MONGO_DB_NAME=ai_talking_toy
# Device access JWT (Phase 7): set a long random value in production
# (independent of DJANGO_SECRET_KEY so it can be rotated separately).
DEVICE_JWT_SECRET=change-me-to-a-long-random-string
DEVICE_JWT_TTL_SECONDS=3600
DEVICE_CHALLENGE_TTL_SECONDS=60
# Wi-Fi onboarding claim tickets: raw ticket TTL (seconds) and the
# per-user redeem attempt limit (sliding window; <= 0 disables, in-memory
# like ROBOT_COMMAND_COOLDOWN_SECONDS).
DEVICE_CLAIM_TTL_SECONDS=600
DEVICE_CLAIM_RATE_LIMIT_ATTEMPTS=10
DEVICE_CLAIM_RATE_LIMIT_WINDOW_SECONDS=60

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ADMIN_PASSWORD=change-me-to-a-long-random-string
MQTT_BRIDGE_PASSWORD=change-me-to-a-long-random-string
# Phase A: per-user/per-robot command cooldown (seconds; 0 disables) and
# conversation-turn payload bounds (backend settings defaults).
ROBOT_COMMAND_COOLDOWN_SECONDS=1
CONVERSATION_MAX_TEXT_LENGTH=4000
CONVERSATION_MAX_AUDIO_BASE64_LENGTH=1400000
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# Conversation-turn throttle (DRF rate, e.g. 30/min = 30 per 60s; empty
# disables).
CONVERSATION_TURN_RATE_LIMIT=30/min

 
AI_SERVICE_INTERNAL_TOKEN=change-me-to-a-long-random-string
# Phase 11: Django -> AI service base URL (Compose network; the service
# publishes no host port) and the Django-side request budget.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_SECONDS=30



AI_STT_PROVIDER=mock
AI_STT_MODEL=
AI_STT_ENDPOINT=
AI_STT_TIMEOUT_SECONDS=30
AI_STT_RETRY_COUNT=1
AI_STT_RETRY_BACKOFF_SECONDS=0.5
AI_LLM_PROVIDER=mock
AI_LLM_MODEL=
AI_LLM_ENDPOINT=
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_RETRY_COUNT=1
AI_LLM_RETRY_BACKOFF_SECONDS=0.5
AI_TTS_PROVIDER=mock
AI_TTS_MODEL=
AI_TTS_ENDPOINT=
AI_TTS_TIMEOUT_SECONDS=30
AI_TTS_RETRY_COUNT=1
AI_TTS_RETRY_BACKOFF_SECONDS=0.5

# LOCAL UI TESTING ONLY - never enable in production. Default is off.
# With DJANGO_DEBUG=true (local-ui overlay), local dashboard page loads
# establish a normal session for the active parent named below so the
# owner-scoped API calls work without the login page. Server-side
# identity only; /api/ paths are never affected.
LOCAL_UI_TEST_BYPASS=false
LOCAL_UI_TEST_USER_EMAIL=

# Cache-busting version for panel static URLs (?v=...). Bump when
# backend/static/js/* or backend/static/css/app.css change so browsers
# do not keep serving a stale cached copy (default in settings.py works
# without this key).
ASSET_VERSION=2026-10-16-2
