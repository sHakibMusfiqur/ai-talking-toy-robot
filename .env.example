# Copy to .env (never commit .env) and replace values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Host-side development/test connection (single-node replica set, direct connection).
MONGO_HOST=mongodb://localhost:27017/?directConnection=true
MONGO_DB_NAME=ai_talking_toy
# Device access JWT (Phase 7): set a long random value in production
# (independent of DJANGO_SECRET_KEY so it can be rotated separately).
DEVICE_JWT_SECRET=change-me-to-a-long-random-string
DEVICE_JWT_TTL_SECONDS=3600
DEVICE_CHALLENGE_TTL_SECONDS=60
