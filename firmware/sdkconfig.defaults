# ESP-IDF tracked defaults — must contain NO secrets (Wi-Fi credentials,
# private keys, tokens and CA material live in the untracked local
# `sdkconfig` / `sdkconfig.local`, see docs/firmware/esp32-mqtt-integration.md).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_CTR_DRBG_C=y
CONFIG_MBEDTLS_ENTROPY_C=y
CONFIG_MBEDTLS_PEM_PARSE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_WIFI_SLP_DEFAULT_MIN_MODEM_T=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_SPIRAM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
